# Copy to .env and fill in to enable real analysis.
# Without a key the app runs fully in demo mode (deterministic local analyses).
ANTHROPIC_API_KEY=

# Only needed if your key is a user-level key (sk-ant-usr-…) that isn't scoped
# to a workspace. Workspace-scoped keys (created inside a workspace in the
# Console) don't need this.
# ANTHROPIC_WORKSPACE_ID=

# Set to 1 to force demo mode even when a key is present (used by e2e tests).
# LENSWORK_FORCE_MOCK=1
